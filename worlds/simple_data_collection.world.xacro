<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- TODO: allow xacro -->
  <xacro:arg name="fast_physics" default="true" />
  <xacro:arg name="trofast_knob" default="true" />
  <xacro:arg name="highrtf" default="false" />

  <world name='simple_data_collection'>
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
    </plugin>

    <scene>
      <grid>false</grid>
    </scene>

    <physics name="1ms" type="ignored">
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
    </physics>

    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose relative_to=''>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--gravity-->
    <gravity>0 0 -9.8</gravity>

    <!-- Import models -->
    <!-- Global Models -->
    <include>
      <name>floor_plane_fl</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>5 5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_fr</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>5 -5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_bl</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>-5 5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_br</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>-5 -5 0 0 0 0</pose>
    </include>

    <include>
      <name>rcjo2026_frame</name>
      <static>1</static>
      <uri>model://rcjo2025_frame</uri>
      <pose relative_to=''>0 0 0 0 0 0</pose>
    </include>
    <!-- Global Models -->

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Living Room / Laundry Area                                          -->
    <!--                                                                     -->
    <!-- Layout changes vs rcjo2025_arena:                                   -->
    <!--   - Removed: counter, kachaka_shelf_left, kachaka_shelf_right       -->
    <!--   - Added:   washing_machine + laundry_basket + pile_of_clothes     -->
    <!--              in the freed kachaka-shelf area (x≈1.4, y=-3.5)       -->
    <!--   - Folding table = existing long_table (x=2.0, y=-0.5)            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Folding table — the long white table already in this room.
         Robot folds T-shirts here. No change in pose from original world. -->
    <include>
      <name>long_table</name>
      <uri>model://wrc_long_table</uri>
      <static>1</static>
      <pose relative_to=''>2.0 -0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>tall_table</name>
      <uri>model://wrc_tall_table</uri>
      <static>1</static>
      <pose relative_to=''>0.75 -0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>trash_box</name>
      <uri>model://trash_box</uri>
      <static>1</static>
      <pose relative_to=''>4.5 -3.5 0 0 0 -1.57</pose>
    </include>

    <!-- Laundry basket — placed to the right of (higher X than) the washer,
         close enough for the robot to reach both washer and basket from one
         navigation waypoint. -->
    <include>
      <name>laundry_basket</name>
      <uri>model://laundry_basket</uri>
      <static>0</static>
      <pose relative_to=''>2.3 -3.2 0.0 0.0 0.0 0.0</pose>
    </include>

    <model name="box_to_pick">
      <static>false</static>
      <pose>2.0 -0.5 0.45 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.075 0.075 0.075</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>1.0</kd>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.075 0.075 0.075</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Living Room / Laundry Area -->


    <!-- Study Room -->
    <include>
      <name>chair_left</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>1.75 3.5 0.0 0.0 0.0 -1.57</pose>
    </include>

    <include>
      <name>chair_right</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>0.75 3.5 0.0 0.0 0.0 -1.57</pose>
    </include>

    <include>
      <name>shelf</name>
      <uri>model://shelf</uri>
      <static>1</static>
      <pose relative_to=''>3.2 3.5 0.0 0.0 0.0 1.57</pose>
    </include>
    <!-- Study Room -->


  </world>
</sdf>
