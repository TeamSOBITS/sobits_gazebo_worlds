<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- TODO: allow xacro -->
  <xacro:arg name="fast_physics" default="true" />
  <xacro:arg name="trofast_knob" default="true" />
  <xacro:arg name="highrtf" default="false" />

  <world name='restaurant'>
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
    </plugin>

    <physics name="4ms" type="ignored">
        <max_step_size>0.004</max_step_size>
        <real_time_update_rate>250</real_time_update_rate>
        <real_time_factor>1.0</real_time_factor>
    </physics>

    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose relative_to=''>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- background color -->
    <scene>
      <background>1.0 1.0 1.0 1.0</background>
      <grid>false</grid>
    </scene>

    <!--gravity-->
    <gravity>0 0 -9.8</gravity>

    <!-- Import models -->
    <!-- Global Models -->
    <include>
      <name>floor_plane_fl</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>5 5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_fr</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>5 -5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_bl</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>-5 5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_br</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>-5 -5 0 0 0 0</pose>
    </include>

    <!-- Furniture Models-->
    <include>
      <name>tall_table_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cafe table</uri>
      <static>1</static>
      <pose relative_to=''>2.2 3.5 0 0 0 0</pose>
    </include>

    <include>
      <name>tall_table_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cafe table</uri>
      <static>1</static>
      <pose relative_to=''>2.2 0.0 0 0 0 0</pose>
    </include>

    <include>
      <name>tall_table_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cafe table</uri>
      <static>1</static>
      <pose relative_to=''>2.2 -3.5 0 0 0 0</pose>
    </include>

    <include>
      <name>chair_1</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>2.8 3.5 0.0 0.0 0.0 3.14</pose>
    </include>

    <include>
      <name>chair_2</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>2.8 0.0 0.0 0.0 0.0 3.14</pose>
    </include>

    <include>
      <name>chair_3</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>2.8 -3.5 0.0 0.0 0.0 3.14</pose>
    </include>

    <include>
      <name>chair_4</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>2.2 4.1 0.0 0.0 0.0 -1.57</pose>
    </include>


    <include>
      <name>chair_5</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>2.2 -4.1 0.0 0.0 0.0 1.57</pose>
    </include>

    <include>
      <name>counter_1</name>
      <uri>model://dining_table</uri>
      <static>1</static>
      <pose relative_to=''>-3.5 -2.25 0.0 0.0 0.0 1.57</pose>
    </include>

    <!-- ceiling models -->
    <model name="ceiling">
      <static>true</static>
      <pose>2.8 0.0 4.0 0 0 0</pose> 
      <link name="ceiling_link">
        <collision name="ceiling_collision">
          <geometry>
            <box><size>10.0 10.0 0.1</size></box>
          </geometry>
        </collision>
        <visual name="ceiling_visual">
          <geometry>
            <box><size>10.0 10.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1.0</ambient>
            <diffuse>0.9 0.9 0.9 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Light models -->
    <light type="point" name="ceiling_light_1">
      <pose>2.8 0.0 2.8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>15.0</range>
        <linear>0.05</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>


    <!-- People models -->
    <include>
      <name>person_1</name>
      <uri>model://person_sitting</uri>
      <!-- <uri>model://owada_left_hand_raising</uri> -->
      <!-- <uri>model://owada_right_hand_raising</uri> -->
      <!-- <uri>model://owada_sitting</uri> -->
      <static>1</static>
      <pose>2.2 -4.1 0.7 0 0 1.57</pose>
    </include>

        <include>
      <name>person_2</name>
      <!-- <uri>model://person_sitting</uri> -->
      <uri>model://owada_left_hand_raising</uri>
      <!-- <uri>model://owada_right_hand_raising</uri> -->
      <!-- <uri>model://owada_sitting</uri> -->
      <static>1</static>
      <pose>2.7 -3.5 0.7 0 0 3.14</pose>
    </include>

        <include>
      <name>person_3</name>
      <uri>model://person_sitting</uri>
      <!-- <uri>model://owada_left_hand_raising</uri> -->
      <!-- <uri>model://owada_right_hand_raising</uri> -->
      <!-- <uri>model://owada_sitting</uri> -->
      <static>1</static>
      <pose>2.7 0.0 0.7 0 0 3.14</pose>
    </include>

    <include>
      <name>person_4</name>
      <uri>model://person_sitting</uri>
      <!-- <uri>model://owada_left_hand_raising</uri> -->
      <!-- <uri>model://owada_right_hand_raising</uri> -->
      <!-- <uri>model://owada_sitting</uri> -->
      <static>1</static>
      <pose>2.7 3.5 0.7 0 0 3.14</pose>
    </include>

    <include>
      <name>person_5</name>
      <uri>model://person_sitting</uri>
      <!-- <uri>model://owada_left_hand_raising</uri> -->
      <!-- <uri>model://owada_right_hand_raising</uri> -->
      <!-- <uri>model://owada_sitting</uri> -->
      <static>1</static>
      <pose>2.2 4.1 0.7 0 0 -1.57</pose>
    </include>

    <!-- RANDOM_YCB_OBJECTS -->

  </world>
</sdf>
