<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <world name='doing_laundry_arena'>
    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors"/>

    <scene><grid>false</grid></scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>

    <!-- Floor -->
    <include><name>floor_plane_fl</name><static>1</static><uri>model://wrc_ground_plane</uri><pose> 5  5 0 0 0 0</pose></include>
    <include><name>floor_plane_fr</name><static>1</static><uri>model://wrc_ground_plane</uri><pose> 5 -5 0 0 0 0</pose></include>
    <include><name>floor_plane_bl</name><static>1</static><uri>model://wrc_ground_plane</uri><pose>-5  5 0 0 0 0</pose></include>
    <include><name>floor_plane_br</name><static>1</static><uri>model://wrc_ground_plane</uri><pose>-5 -5 0 0 0 0</pose></include>

    <include>
      <name>rcjo2025_frame</name>
      <static>1</static>
      <uri>model://rcjo2025_frame</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Entrance door blocker (pose matches image1) -->
    <model name="entrance_door_blocker">
      <static>true</static>
      <!-- from image1 UI: x=-0.06, y=-1.98, z=1.00, r=p=yaw=0 -->
      <pose>-0.06 -1.98 1.00 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 1.0 2.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.0 2.05</size></box></geometry>
          <material><diffuse>0.2 0.2 0.2 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Laundry area -->
    <include>
      <name>laundry_room#folding_table</name>
      <uri>model://wrc_long_table</uri>
      <static>1</static>
      <pose>2.0 -0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>laundry_room#tall_table</name>
      <uri>model://wrc_tall_table</uri>
      <static>1</static>
      <pose>0.75 -0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>washing_machine</name>
      <uri>model://washing_machine</uri>
      <static>0</static>
      <pose>1.375 -3.5 0.0 0.0 0.0 1.5708</pose>
    </include>

    <include>
      <name>laundry_basket</name>
      <uri>model://laundry_basket</uri>
      <static>0</static>
      <pose>2.3 -3.2 0.0 0.0 0.0 0.0</pose>
    </include>

        <!-- Folded shirts (GLB-based models) -->
    <!-- Table (1) -->
    <include>
      <name>folded_shirt_table_0</name>
      <uri>model://folded_shirt_white</uri>
      <static>0</static>
      <pose>2.00 -0.50 0.78 0 0 0</pose>
    </include>

    <!-- Washing machine (3) - TODO: tune pose to be inside drum -->
    <include>
      <name>folded_shirt_washer_0</name>
      <uri>model://folded_shirt_green</uri>
      <static>0</static>
      <pose>1.33 -3.50 0.60 0 0 1.57</pose>
    </include>
    <include>
      <name>folded_shirt_washer_1</name>
      <uri>model://folded_shirt_white</uri>
      <static>0</static>
      <pose>1.40 -3.45 0.60 0 0 1.20</pose>
    </include>
    <include>
      <name>folded_shirt_washer_2</name>
      <uri>model://folded_shirt_green</uri>
      <static>0</static>
      <pose>1.28 -3.55 0.60 0 0 1.90</pose>
    </include>

    <!-- Basket (2) - TODO: tune pose to be inside basket -->
    <include>
      <name>folded_shirt_basket_0</name>
      <uri>model://folded_shirt_white</uri>
      <static>0</static>
      <pose>2.30 -3.20 0.22 0 0 0.20</pose>
    </include>
    <include>
      <name>folded_shirt_basket_1</name>
      <uri>model://folded_shirt_green</uri>
      <static>0</static>
      <pose>2.35 -3.15 0.22 0 0 -0.30</pose>
    </include>

  </world>
</sdf>