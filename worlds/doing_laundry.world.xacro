<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <world name='doing_laundry_arena'>
    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors"/>

    <scene><grid>false</grid></scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>

    <!-- Floor -->
    <include><name>floor_plane_fl</name><static>1</static><uri>model://wrc_ground_plane</uri><pose> 5  5 0 0 0 0</pose></include>
    <include><name>floor_plane_fr</name><static>1</static><uri>model://wrc_ground_plane</uri><pose> 5 -5 0 0 0 0</pose></include>
    <include><name>floor_plane_bl</name><static>1</static><uri>model://wrc_ground_plane</uri><pose>-5  5 0 0 0 0</pose></include>
    <include><name>floor_plane_br</name><static>1</static><uri>model://wrc_ground_plane</uri><pose>-5 -5 0 0 0 0</pose></include>

    <include>
      <name>rcjo2025_frame</name>
      <static>1</static>
      <uri>model://rcjo2025_frame</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Entrance door (open/close by pose update) -->
    <model name="entrance_door">
      <static>false</static>
      <pose>0.02 -3.01 0.87 0 0 0</pose>

      <link name="door_link">

        <collision name="collision">
          <pose>0 1 0 0 0 0</pose>
          <geometry>
            <box><size>0.05 2.0 2.05</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 1 0 0 0 0</pose>
          <geometry>
            <box><size>0.05 2.0 2.05</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>

        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Laundry area -->
    <include>
      <name>laundry_room#folding_table</name>
      <uri>model://wrc_long_table</uri>
      <static>1</static>
      <pose>2.0 -0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>laundry_room#tall_table</name>
      <uri>model://wrc_tall_table</uri>
      <static>1</static>
      <pose>0.75 -0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>washing_machine</name>
      <uri>model://washing_machine</uri>
      <static>0</static>
      <pose>1.375 -3.5 0.0 0.0 0.0 1.5708</pose>
    </include>

    <include>
      <name>laundry_basket</name>
      <uri>model://laundry_basket</uri>
      <static>0</static>
      <pose>2.3 -3.2 0.0 0.0 0.0 0.0</pose>
    </include>


    <include>
      <name>folded_shirt_front</name>
      <uri>model://folded_shirt_white</uri>
      <static>0</static>
      <pose>2.18 -0.49 0.41 1.5708  0 0</pose>
    </include>



    <include>
      <name>folded_shirt_back_1</name>
      <uri>model://folded_shirt_white</uri>
      <static>0</static>
      <pose>1.51 -0.49 0.41 1.5708  0 0</pose>
    </include>

    <include>
      <name>folded_shirt_back_2</name>
      <uri>model://folded_shirt_green</uri>
      <static>0</static>
      <pose>1.88 -0.49 0.41 1.5708  0 0</pose>
    </include>

  </world>
</sdf>