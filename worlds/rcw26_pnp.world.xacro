<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- TODO: allow xacro -->
  <xacro:arg name="fast_physics" default="true" />
  <xacro:arg name="trofast_knob" default="true" />
  <xacro:arg name="highrtf" default="false" />

  <world name='rcw26_pnp_arena'>
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
    </plugin>

    <scene>
      <grid>false</grid>
    </scene>

    <physics name="4ms" type="ignored">
        <max_step_size>0.004</max_step_size>
        <real_time_update_rate>250</real_time_update_rate>
        <real_time_factor>1.0</real_time_factor>
    </physics>

    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose relative_to=''>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--gravity-->
    <gravity>0 0 -9.8</gravity>

    <!-- Import models -->
    <!-- Global Models -->
    <include>
      <name>floor_plane_fl</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>5 5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_fr</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>5 -5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_bl</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>-5 5 0 0 0 0</pose>
    </include>
    <include>
      <name>floor_plane_br</name>
      <static>1</static>
      <uri>model://wrc_ground_plane</uri>
      <pose relative_to=''>-5 -5 0 0 0 0</pose>
    </include>

    <include>
      <name>rcjo2026_frame</name>
      <static>1</static>
      <uri>model://wrc2026_frame</uri>
      <pose relative_to=''>0 0 0 0 0 0</pose>
    </include>
    <!-- Global Models -->


    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Arena Entrance Door (inline box model)                               -->
    <!--                                                                     -->
    <!-- Arena front wall is at x=-5.0. Three wall segments leave two 1 m   -->
    <!-- gaps. This door fills the gap nearest the laundry area:             -->
    <!--   wall_front_right : y=-5.0 → -3.0  (ends at y=-3.0)              -->
    <!--   wall_front_center: y=-2.0 → +1.0  (starts at y=-2.0)            -->
    <!--   Gap centre       : y=-2.5, x=-5.0  (1.0 m wide)                 -->
    <!--                                                                     -->
    <!-- OPEN  pose (default): panel swung 90° into arena alongside          -->
    <!--   wall_front_right inner face.                                      -->
    <!--   centre (-4.55, -3.0, 1.0), yaw=0 — panel runs along world-X     -->
    <!--                                                                     -->
    <!-- CLOSED pose (for testing): change to  -5.0 -2.5 1.0 0 0 1.5708   -->
    <!--   panel will block the gap and LiDAR will detect it as obstacle    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <model name="arena_door">
      <static>true</static>
      <pose>-5.0 1.98 1.0 0 0 1.5708</pose>

      <link name="panel">
        <collision name="col">
          <geometry><box><size>0.9 0.05 2.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.9 0.05 2.0</size></box></geometry>
          <material>
            <ambient>0.72 0.52 0.32 1</ambient>
            <diffuse>0.72 0.52 0.32 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>place_dining_table</name>
      <uri>model://dining_table</uri>
      <static>1</static>
      <pose relative_to=''>-2.0 -2.25 0.0 0.0 0.0 0.0</pose>
    </include>
<!-- 
    <include>
      <name>couch_left</name>
      <uri>model://sofa</uri>
      <static>1</static>
      <pose relative_to=''>-3.35 -2.75 0.0 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>couch_right</name>
      <uri>model://sofa</uri>
      <static>1</static>
      <pose relative_to=''>-3.35 -1.75 0.0 0.0 0.0 0.0</pose>
    </include> -->

    <include>
      <name>shelf</name>
      <uri>model://shelf</uri>
      <static>1</static>
      <pose relative_to=''>-0.36 3.5 0.0 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>dining_table</name>
      <uri>model://dining_table</uri>
      <static>1</static>
      <pose relative_to=''>-2.9 3.25 0.0 0.0 0.0 1.57</pose>
    </include>

    <!-- <include>
      <name>ycb_010_tomato_soup_can</name>
      <uri>model://ycb_010_tomato_soup_can</uri>
      <static>0</static>
      <pose relative_to=''>-2.9 3.05 0.80 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>ycb_013_apple</name>
      <uri>model://ycb_013_apple</uri>
      <static>0</static>
      <pose relative_to=''>-2.9 2.90 0.80 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>ycb_024_bowl</name>
      <uri>model://ycb_024_bowl</uri>
      <static>0</static>
      <pose relative_to=''>-2.7 2.80 0.80 0.0 0.0 0.0</pose>
    </include> -->

    <include>
      <name>ycb_015_peach</name>
      <uri>model://ycb_015_peach</uri>
      <static>0</static>
      <pose relative_to=''>-2.7 2.90 0.80 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>ycb_012_strawberry</name>
      <uri>model://ycb_012_strawberry</uri>
      <static>0</static>
      <pose relative_to=''>-2.7 2.70 0.80 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>ycb_025_mug</name>
      <uri>model://ycb_025_mug</uri>
      <static>0</static>
      <pose relative_to=''>-2.66 2.80 0.80 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>ycb_031_spoon</name>
      <uri>model://ycb_031_spoon</uri>
      <static>0</static>
      <pose relative_to=''>-3.1 3.00 0.9 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>ycb_013_apple</name>
      <uri>model://ycb_013_apple</uri>
      <static>0</static>
      <pose relative_to=''>-2.9 2.90 0.80 0.0 0.0 0.0</pose>
    </include>



  </world>
</sdf>
