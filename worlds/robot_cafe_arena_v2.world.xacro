<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- TODO: allow xacro -->
  <xacro:arg name="fast_physics" default="true" />
  <xacro:arg name="trofast_knob" default="true" />
  <xacro:arg name="highrtf" default="false" />

  <world name='robot_cafe_arena'>
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
    </plugin>

    <plugin
        filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>

    <physics name="1ms" type="ignored">
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose relative_to=''>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--gravity-->
    <gravity>0 0 -9.8</gravity>

    <!-- Import models -->
    <!-- Global Models -->
    <include>
      <name>robot_cafe_arena_v2_floor</name>
      <static>1</static>
      <uri>model://robot_cafe_arena_v2/floor</uri>
      <pose relative_to=''>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>robot_cafe_arena_v2_frame</name>
      <static>1</static>
      <uri>model://robot_cafe_arena_v2/frame</uri>
      <pose relative_to=''>0 0 0 0 0 0</pose>
    </include>
    <!-- Global Models -->


    <!-- Counter -->
    <include>
      <name>long_table</name>
      <uri>model://wrc_long_table</uri>
      <static>1</static>
      <pose relative_to=''>-1.26 4.34 0 0 0 -1.57</pose>
    </include>

    <include>
      <name>wooden_law_table</name>
      <uri>model://wooden_law_table</uri>
      <static>1</static>
      <pose relative_to=''>1.60 0.31 0.0 0.0 0.0 -1.57</pose>
    </include>

    <include>
      <name>shelf</name>
      <uri>model://shelf</uri>
      <static>1</static>
      <pose relative_to=''>3.62 0.28 0.0 0.0 0.0 -1.57</pose>
    </include>

    <include>
      <name>customer</name>
      <uri>model://person_standing</uri>
      <static>1</static>
      <pose relative_to=''>-2.26 4.34 0.0 0.0 0.0 1.57</pose>
    </include>


    <!-- Customer Area -->
    <include>
      <name>table1</name>
      <uri>model://wooden_table</uri>
      <static>1</static>
      <pose relative_to=''>-1.8 -3.5 0.0 0.0 0.0 -1.57</pose>
    </include>

    <include>
      <name>table2</name>
      <uri>model://wooden_table</uri>
      <static>1</static>
      <pose relative_to=''>-1.8 -1.6 0.0 0.0 0.0 -1.57</pose>
    </include>

    <include>
      <name>table3</name>
      <uri>model://wooden_table</uri>
      <static>1</static>
      <pose relative_to=''>-1.8 0.3 0.0 0.0 0.0 -1.57</pose>
    </include>

    <include>
      <name>table1_chair_front</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>-2.8 -3.5 0.0 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>table1_chair_back</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>-0.8 -3.5 0.0 0.0 0.0 3.14</pose>
    </include>

    <include>
      <name>table2_chair_front</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>-2.8 -1.6 0.0 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>table2_chair_back</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>-0.8 -1.6 0.0 0.0 0.0 3.14</pose>
    </include>

    <include>
      <name>table3_chair_front</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>-2.8 0.3 0.0 0.0 0.0 0.0</pose>
    </include>

    <include>
      <name>table3_chair_back</name>
      <uri>model://chair</uri>
      <static>1</static>
      <pose relative_to=''>-0.8 0.3 0.0 0.0 0.0 3.14</pose>
    </include>
  </world>
</sdf>
