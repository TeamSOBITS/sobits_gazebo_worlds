<?xml version="1.0" ?>
<!-- Door — real-furniture GLB. Y-up; scale=1.9979, roll=1.5708 -> Z-up.
     Height ~2.00 m, footprint ~0.93x0.17 m. Simple box collision.

     HINGED: the panel swings on a revolute joint about the model origin, which
     sits at the hinge edge (NOT the panel centre). Place the model at the jamb
     you want it hinged on; the panel extends +X from there, so the include's
     yaw decides which way it faces and which side it swings.

     Commandable AND pushable: JointPositionController holds the commanded
     angle with deliberately soft gains, and joint damping/friction let the
     robot shove the door off that angle instead of hitting an immovable wall.
       open : gz topic -t /model/<name>/joint/hinge/0/cmd_pos -m gz.msgs.Double -p 'data: 1.5708'
       close: same topic, 'data: 0.0'
-->
<sdf version="1.10">
  <model name="rcw26_door">
    <static>false</static>

    <!-- Anchor link, pinned to the world by frame_fixed so the panel has an
         immovable parent to hinge against. Without this the whole model is a
         free body: it drifts and tumbles instead of swinging on the joint. -->
    <!-- Mass is small but NOT negligible: a near-zero-inertia link attached to
         a 20 kg child makes the constraint solver ill-conditioned and the
         joint jitters. -->
    <link name="frame">
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
      </inertial>
    </link>
    <joint name="frame_fixed" type="fixed">
      <parent>world</parent>
      <child>frame</child>
    </joint>

    <!-- Panel geometry is offset -X by half its width (0.928/2 = 0.464) so the
         model origin lands on the hinge edge and the panel extends -X.
         The sign matters: the GLB puts the doorknob near the panel's -X edge,
         so extending -X leaves the knob at the FREE edge, opposite the hinge.
         Inertia is the 20 kg slab about its own centre (standard box formula). -->
    <link name="panel">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.464 0 0.94 0 0 0</pose>
        <mass>20</mass>
        <inertia>
          <ixx>5.89667</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>7.32597</iyy><iyz>0</iyz>
          <izz>1.44131</izz>
        </inertia>
      </inertial>
      <!-- Collision = door PANEL only (depth 0.06 m), excluding the doorknob
           that protrudes from both faces (GLB footprint depth 0.165 m). -->
      <!-- Height 1.88, NOT the mesh's 2.0: the door-frame header lintel starts
           at z=1.90, so a 2.0 m collision box wedges into it and the panel
           cannot swing. The visual keeps full height; only collision clears. -->
      <collision name="collision">
        <pose>-0.464 0 0.9400 0 0 0</pose>
        <geometry><box><size>0.928 0.060 1.880</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>-0.464 0 1.0000 1.5708 0 0</pose>
        <geometry><mesh><uri>model://rcw26_door/meshes/door.glb</uri><scale>1.9979 1.9979 1.9979</scale></mesh></geometry>
      </visual>
    </link>

    <!-- Swings 0 (closed) to +90 deg. Damping and friction keep it from
         flapping and let it hold a pushed-open position. -->
    <joint name="hinge" type="revolute">
      <parent>frame</parent>
      <child>panel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.5708</upper>
          <effort>50.0</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>3.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Soft gains: enough to drive the door open/closed, weak enough that the
         robot can push it aside. Raise p_gain for a door that resists more. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>hinge</joint_name>
      <p_gain>8.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>1.5</d_gain>
      <cmd_max>25.0</cmd_max>
      <cmd_min>-25.0</cmd_min>
    </plugin>
  </model>
</sdf>
