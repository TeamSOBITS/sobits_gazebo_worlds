
<?xml version="1.0"?>
<sdf version="1.10">
  <model name="chair_gray">
    <static>false</static>
    <link name="link">
      <!-- 90度回転を防止 -->
      <pose>0 0 0.47 1.5708 0 1.57</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://chair_gray/meshes/chair_gray.glb</uri>
            <scale>0.95 0.95 0.95</scale>
          </mesh>
        </geometry>
        <material>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <roughness>0.6</roughness>
              <emissive_map>model://chair_gray/meshes/chair_gray_img0.png</emissive_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://chair_gray/meshes/chair_gray.glb</uri>
            <scale>0.95 0.95 0.95</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
