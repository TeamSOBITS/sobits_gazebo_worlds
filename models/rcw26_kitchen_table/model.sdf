<?xml version="1.0" ?>
<!--
  Kitchen Table — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=1.2158 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~1.2x1.21 m, height ~1.0 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_kitchen_table">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>20</mass>
        <inertia>
          <ixx>4.10683</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.06667</iyy><iyz>0</iyz>
          <izz>4.84017</izz>
        </inertia>
      </inertial>
      <!-- Cylinder collision (round table). radius = half footprint (~0.43),
           height 0.72, centred at z=0.36. -->
      <collision name="collision">
        <pose>0 0 0.3600 0 0 0</pose>
        <geometry><cylinder><radius>0.434</radius><length>0.720</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3600 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_kitchen_table/meshes/kitchen_table.glb</uri>
            <scale>0.8736 0.8736 0.8736</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
