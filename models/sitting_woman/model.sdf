
<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sitting_woman">
    <static>true</static>
    <link name="link">
      <!-- 90度回転を防止 & デフォルトで X 軸正方向を向くようにする -->
      <pose>0 0 0 1.5708 0 3.16</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://sitting_woman/meshes/sitting_woman.glb</uri>
            <scale>1.4000 1.4000 1.4000</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://sitting_woman/meshes/sitting_woman.glb</uri>
            <scale>1.4000 1.4000 1.4000</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
