<?xml version="1.0" ?>
<!-- Chair (GLB) — real-furniture GLB variant. GLB unit-normalized + Y-up;
     uniform scale=0.8991 -> real size, roll=1.5708 corrects Y-up->Z-up.
     World footprint ~0.52x0.62 m, height ~0.9 m. Box collision approximates mesh. -->
<sdf version="1.10">
  <model name="rcw26_chair">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.49767</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.45017</iyy><iyz>0</iyz><izz>0.27283</izz></inertia>
      </inertial>
      <!-- Collision uses the GLB mesh itself (true chair shape). Same
           pose/scale as the visual. -->
      <collision name="collision">
        <pose>0 0 0.4500 1.5708 0 0</pose>
        <geometry><mesh><uri>model://rcw26_chair/meshes/chair.glb</uri><scale>0.8991 0.8991 0.8991</scale></mesh></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.4500 1.5708 0 0</pose>
        <geometry><mesh><uri>model://rcw26_chair/meshes/chair.glb</uri><scale>0.8991 0.8991 0.8991</scale></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
