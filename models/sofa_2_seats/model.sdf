
<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sofa_2_seats">
    <static>false</static>
    <link name="link">
      <!-- 90度回転を防止 -->
      <pose>0 0 0 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://sofa_2_seats/meshes/sofa_2_seats.glb</uri>
            <scale>0.0100 0.0100 0.0100</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://sofa_2_seats/meshes/sofa_2_seats.glb</uri>
            <scale>0.0100 0.0100 0.0100</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
