<?xml version="1.0" ?>
<!--
  Sink — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=1.0 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~1.0x0.37 m, height ~0.52 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_sink">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>25</mass>
        <inertia>
          <ixx>0.84854</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.64667</iyy><iyz>0</iyz>
          <izz>2.36854</izz>
        </inertia>
      </inertial>
      <!-- Collision height reduced by 20cm (0.75 -> 0.55), floor-anchored, so
           the collision top sits at z=0.55 and the broader lower surface is
           usable/reachable. Footprint unchanged. -->
      <collision name="collision">
        <pose>0 0 0.2750 0 0 0</pose>
        <geometry><box><size>1.440 0.534 0.550</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3750 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_sink/meshes/sink.glb</uri>
            <scale>1.4394 1.4394 1.4394</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
