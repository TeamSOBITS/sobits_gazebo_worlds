<?xml version="1.0"?>
<model>
  <name>Pile of Clothes (T-shirts)</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>SOBITS Team / RoboCup@Home 2026</name>
    <email>kvalentincardenas@hotmail.com</email>
  </author>

  <description>
    Visual-only pile of T-shirts for the RoboCup@Home 2026 Doing Laundry challenge.
    Placed inside or next to the laundry basket to indicate clothing items.
    No collision — the actual cloth manipulation uses individual T-shirt poses
    detected by @perception-3d (YOLO/SAM3 on depth camera).
    Static model; no physics needed.
  </description>
</model>
