<?xml version="1.0" ?>
<!--
  Washing Machine Open — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=0.85 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~0.79x0.85 m, height ~0.73 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_washing_machine_open">
    <static>false</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>50</mass>
        <inertia>
          <ixx>5.23083</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.82083</iyy><iyz>0</iyz>
          <izz>5.61083</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.3650 0 0 0</pose>
        <geometry><box><size>0.790 0.850 0.730</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3650 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_washing_machine_open/meshes/washing_machine_open.glb</uri>
            <scale>0.85 0.85 0.85</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
