<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="arm_chair">
    <static>true</static> 
    
    <link name="link">
      <!-- 90度回転を防止 -->
      <pose>0 0 0 1.5708 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://arm_chair/meshes/arm_chair.glb</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://arm_chair/meshes/arm_chair.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
