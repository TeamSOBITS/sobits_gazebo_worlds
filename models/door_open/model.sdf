<sdf version="1.6">
  <model name="door">
    <static>false</static>
    <link name="door_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial><mass>1.0</mass></inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://door_open/meshes/door_visual.DAE</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://door_open/meshes/door_collision.DAE</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <link name="hinge_link"/>

    <joint name="door_hinge_joint" type="revolute">
      <parent>hinge_link</parent>
      <child>door_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.57</upper>
        </limit>
      </axis>
    </joint>

    <!-- <plugin name="door_control" filename="libignition-gazebo-joint-controller-system.so">
      <joint_name>door_hinge_joint</joint_name>
      <position>1.57</position>
      <velocity>0.5</velocity>
    </plugin> -->

    <!-- プラグインで自動開閉 -->
    <!-- <plugin name="door_controller" filename="libgazebo_ros_joint_position_controller.so">
      <ros>
        <namespace>/door</namespace>
      </ros>
      <joint>door_hinge</joint>
      <pid>1.0 3.8 0.1</pid>
      <command_topic>~/command</command_topic>
    </plugin> -->
    <plugin name="joint_controller" filename="gz-sim-joint-controller-system">
      <ros>
        <namespace>/door</namespace>
      </ros>
      <joint>door_hinge</joint>
      <pid>1.0 3.8 0.1</pid>
      <command_topic>~/command</command_topic>
    </plugin>
  </model>
  
</sdf>