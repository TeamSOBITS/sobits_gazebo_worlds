<?xml version="1.0"?>
<model>
  <name>Laundry Basket (IKEA TORKIS)</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>SOBITS Team / RoboCup@Home 2026</name>
    <email>kvalentincardenas@hotmail.com</email>
  </author>

  <description>
    Lightweight laundry basket (IKEA TORKIS style) for the RoboCup@Home 2026
    Doing Laundry challenge. GLB mesh visual with simplified box collision.
    Requires bimanual grasping. Contains pile_of_clothes model when spawned.
    If the basket appears wrong size, adjust the GLB scale in model.sdf.
  </description>
</model>
