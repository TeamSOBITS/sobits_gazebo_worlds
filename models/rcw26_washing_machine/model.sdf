<?xml version="1.0" ?>
<!--
  Washing Machine — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=0.8509 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~0.6x0.62 m, height ~0.85 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_washing_machine">
    <static>false</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>50</mass>
        <inertia>
          <ixx>4.61208</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.51042</iyy><iyz>0</iyz>
          <izz>3.10167</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.4250 0 0 0</pose>
        <geometry><box><size>0.603 0.618 0.850</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.4250 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_washing_machine/meshes/washing_machine_close.glb</uri>
            <scale>0.8508 0.8508 0.8508</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
