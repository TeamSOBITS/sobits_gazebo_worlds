<?xml version="1.0" ?>
<!--
  Laundry Basket — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=0.5522 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~0.55x0.37 m, height ~0.42 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_laundry_basket">
    <static>false</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00783</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.01197</iyy><iyz>0</iyz>
          <izz>0.01099</izz>
        </inertia>
      </inertial>
      <!-- Collision uses the GLB mesh itself (true basket shape, hollow
           interior follows the mesh). Same pose/scale as the visual. -->
      <collision name="collision">
        <pose>0 0 0.1800 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_laundry_basket/meshes/laundry_basket.glb</uri>
            <scale>0.4692 0.4692 0.4692</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.1800 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_laundry_basket/meshes/laundry_basket.glb</uri>
            <scale>0.4692 0.4692 0.4692</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ── Grasp handles (bimanual grasping target) ──────────────────────
         Two horizontal cylinder rods at the rim on the +X / -X sides.
         Basket half-X = 0.234. Handle centre at +/-0.222 so the rod's outer
         edge (centre + radius 0.012 = 0.234) COINCIDES with the basket width
         instead of protruding. Rim height ~0.34. Axis along Y (rod runs
         left-right) so each arm grips a rod. Exposed as TF-able links
         handle_left/handle_right for @manip-deformable / @perception-3d. -->
    <link name="handle_right">
      <pose>0.222 0 0.34 1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.012</radius><length>0.18</length></cylinder></geometry>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>
    <link name="handle_left">
      <pose>-0.222 0 0.34 1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.012</radius><length>0.18</length></cylinder></geometry>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>

    <!-- Fixed joints welding handles to the basket body -->
    <joint name="handle_right_joint" type="fixed">
      <parent>link</parent>
      <child>handle_right</child>
    </joint>
    <joint name="handle_left_joint" type="fixed">
      <parent>link</parent>
      <child>handle_left</child>
    </joint>
  </model>
</sdf>
