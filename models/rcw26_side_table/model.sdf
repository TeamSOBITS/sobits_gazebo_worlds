<?xml version="1.0" ?>
<!--
  Side Table — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=0.5556 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~0.35x0.35 m, height ~0.55 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_side_table">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>8</mass>
        <inertia>
          <ixx>0.28333</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.28333</iyy><iyz>0</iyz>
          <izz>0.16333</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.3000 0 0 0</pose>
        <geometry><box><size>0.384 0.383 0.600</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3000 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_side_table/meshes/side_table.glb</uri>
            <scale>0.6058 0.6058 0.6058</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
