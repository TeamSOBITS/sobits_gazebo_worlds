
<?xml version="1.0"?>
<sdf version="1.10">
  <model name="owada_sitting">
    <static>false</static>
    <link name="link">
      <!-- 90度回転を防止 -->
      <pose>0 0 0.7 1.5708 0 1.57</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://owada_sitting/meshes/owada_sitting.glb</uri>
            <scale>1.4 1.4 1.4</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://owada_sitting/meshes/owada_sitting.glb</uri>
            <scale>1.4 1.4 1.4</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
