<?xml version="1.0" ?>
<!-- Laundry Desk — real-furniture GLB. Y-up; scale=1.1729, roll=1.5708 -> Z-up.
     World footprint ~1.17x0.61 m, height ~0.75 m. -->
<sdf version="1.10">
  <model name="rcw26_laundry_desk">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial><mass>18</mass>
        <inertia><ixx>1.39778</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.90624</iyy><iyz>0</iyz><izz>2.61652</izz></inertia>
      </inertial>
      <!-- Collision uses the GLB mesh itself (true desk shape). Same
           pose/scale as the visual. -->
      <collision name="collision">
        <pose>0 0 0.3675 1.5708 0 0</pose>
        <geometry><mesh><uri>model://rcw26_laundry_desk/meshes/laundry_desk.glb</uri><scale>1.1495 1.1495 1.1495</scale></mesh></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3675 1.5708 0 0</pose>
        <geometry><mesh><uri>model://rcw26_laundry_desk/meshes/laundry_desk.glb</uri><scale>1.1495 1.1495 1.1495</scale></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
