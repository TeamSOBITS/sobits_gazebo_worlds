<?xml version="1.0" ?>
<!--
  Trashbin — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=0.6 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~0.46x0.39 m, height ~0.6 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_trashbin">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.12802</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.14290</iyy><iyz>0</iyz>
          <izz>0.09093</izz>
        </inertia>
      </inertial>
      <!-- Collision uses the GLB mesh itself (true bin shape, hollow interior
           follows the mesh). Same pose/scale as the visual. -->
      <collision name="collision">
        <pose>0 0 0.2000 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_trashbin/meshes/trashbin.glb</uri>
            <scale>0.3998 0.3998 0.3998</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.2000 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_trashbin/meshes/trashbin.glb</uri>
            <scale>0.3998 0.3998 0.3998</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
