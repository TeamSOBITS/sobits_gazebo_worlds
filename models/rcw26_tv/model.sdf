  <model name="rcw26_tv">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial><mass>8</mass>
        <inertia><ixx>0.40096</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.03672</iyy><iyz>0</iyz><izz>0.78434</izz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0.3500 0 0 0</pose>
        <geometry><box><size>1.032 0.334 0.700</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3500 1.5708 0 0</pose>
        <geometry><mesh><uri>model://rcw26_tv/meshes/tv.glb</uri><scale>1.0304 1.0304 1.0304</scale></mesh></geometry>
