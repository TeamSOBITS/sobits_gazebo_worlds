<?xml version="1.0" ?>
<!--
  Dishwasher Close — real-furniture GLB model (RoboCup@Home 2026).
  GLB is unit-normalized + Y-up; uniform scale=1.2146 brings it to real size,
  roll=1.5708 corrects Y-up -> Z-up. World footprint ~0.43x0.41 m, height ~0.6 m.
  Box collision approximates the mesh; tune sizes/pose if grasp/nav needs it.
-->
<sdf version="1.10">
  <model name="rcw26_dishwasher_close">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>30</mass>
        <inertia>
          <ixx>1.32025</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.36225</iyy><iyz>0</iyz>
          <izz>0.88250</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.3000 0 0 0</pose>
        <geometry><box><size>0.430 0.410 0.600</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3000 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://rcw26_dishwasher_close/meshes/dishwasher_close.glb</uri>
            <scale>1.2146 1.2146 1.2146</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
