<?xml version="1.0"?>
<model>
  <name>Washing Machine</name>
  <version>2.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>SOBITS Team / RoboCup@Home 2026</name>
    <email>kvalentincardenas@hotmail.com</email>
  </author>

  <description>
    Front-loading washing machine with articulated revolute door joint for the
    RoboCup@Home 2026 Doing Laundry challenge. Updated from ROS1/Gazebo Classic
    to Gazebo Harmonic (gz-sim 8, SDF 1.8). Meshes in mm scale (scale=0.001).
    Door joint: revolute, axis Z, 0–100 deg, hinge on left side of porthole.
  </description>
</model>
