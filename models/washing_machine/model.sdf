<?xml version="1.0" ?>
<!--
  Washing Machine — Gazebo Harmonic (gz-sim 8, SDF 1.8)

  Mesh scale: 0.001 (source STL/DAE are in millimetres)
  Body bounds (at scale 1.0): x∈[−360,360] y∈[−323,323] z∈[0,1060] mm
  Body at scale 0.001: 0.72m wide × 0.646m deep × 1.06m tall

  Door joint (revolute about the hinge z, tilted 8° with the front panel):
    Hinge pose and limits from the source model, tork-a/3dmodeling-examples
    models/urdf/washing-machine_links.urdf joint1 (same door/body meshes):
      xyz (0.30658, −0.258, 0.67582), rpy (0, −0.1396, 0)
    Limits: 0 rad (closed) → −1.8326 rad (105°, fully open)
-->
<sdf version="1.8">
  <model name="washing_machine">

    <!-- ── Body link ─────────────────────────────────────────────────────── -->
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <!-- Heavy appliance — effectively static once placed -->
        <mass>60.0</mass>
        <inertia>
          <ixx>8.0</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>6.0</iyy> <iyz>0</iyz>
          <izz>5.0</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/main-body_lod.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/main-body.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ── Door link ─────────────────────────────────────────────────────── -->
    <!--
      The door link's origin IS the hinge point.
      door.stl bounds at scale 0.001: x∈[−0.135, 0.046] y∈[−0.005, 0.498] z∈[−0.24, 0.24]
      When joint=0 (closed): door panel extends +y from hinge, covering porthole.
      When joint=-1.8326 rad (open): door panel swings out of the front face.
    -->
    <link name="door">
      <!-- Link origin = hinge (tork-a joint1); door meshes are modelled about it -->
      <pose>0.30658 -0.258 0.67582 0 -0.1396 0</pose>

      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.05</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.02</iyy> <iyz>0</iyz>
          <izz>0.06</izz>
        </inertia>
      </inertial>

      <collision name="door_collision">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/door_lod.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="door_visual">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/door.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ── Door revolute joint ───────────────────────────────────────────── -->
    <joint name="door_hinge" type="revolute">
      <parent>body</parent>
      <child>door</child>
      <!-- Joint frame coincides with door link origin → pose = 0 relative to child -->
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <!-- Hinge z in the joint (= door) frame, tilted with the front panel -->
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.8326</lower>  <!-- 105 degrees open -->
          <upper>0</upper>
          <effort>20.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>1.5</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Detergent tray; pose and slide from tork-a joint2 -->
    <link name="tray">
      <pose>0.0 -0.190 0.956 0 0 0</pose>

      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.001</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.001</iyy> <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="tray_collision">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/tray_lod.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="tray_visual">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/tray.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="tray_slide" type="prismatic">
      <parent>body</parent>
      <child>tray</child>
      <axis>
        <!-- Pulls out of the front face (+x) -->
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.200</upper>
          <effort>20.0</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <!-- Friction keeps it where it is left -->
          <damping>5.0</damping>
          <friction>2.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Prevent the whole model from sliding on the floor -->
    <static>false</static>
    <self_collide>false</self_collide>

  </model>
</sdf>
