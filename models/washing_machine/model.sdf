<?xml version="1.0" ?>
<!--
  Washing Machine — Gazebo Harmonic (gz-sim 8, SDF 1.8)

  Mesh scale: 0.001 (source STL/DAE are in millimetres)
  Body bounds (at scale 1.0): x∈[−360,360] y∈[−323,323] z∈[0,1060] mm
  Body at scale 0.001: 0.72m wide × 0.646m deep × 1.06m tall

  Door joint (revolute, axis Z = vertical):
    Hinge in body frame: (0.32, −0.22, 0.53)
      x = front face of machine
      y = left edge of porthole circle (porthole ⌀≈0.44m centred at y=0)
      z = door centre height (1.06 / 2)
    Open direction: +Z rotation (door swings to the robot's left when facing machine)
    Limits: 0 rad (closed) → 1.745 rad (100°, fully open)

  Tune the joint pose x/y/z values in this file if the door looks misaligned in Gazebo.
-->
<sdf version="1.8">
  <model name="washing_machine">

    <!-- ── Body link ─────────────────────────────────────────────────────── -->
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <!-- Heavy appliance — effectively static once placed -->
        <mass>60.0</mass>
        <inertia>
          <ixx>8.0</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>6.0</iyy> <iyz>0</iyz>
          <izz>5.0</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/main-body.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/main-body.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ── Door link ─────────────────────────────────────────────────────── -->
    <!--
      The door link's origin IS the hinge point.
      door.stl bounds at scale 0.001: x∈[−0.135, 0.046] y∈[−0.005, 0.498] z∈[−0.24, 0.24]
      When joint=0 (closed): door panel extends +y from hinge, covering porthole.
      When joint=1.745 rad (open): door panel swings +x (away from machine front face).
    -->
    <link name="door">
      <!-- Initial pose = hinge position in model frame -->
      <pose>0.32 -0.22 0.65 0 0 -1.5708</pose>

      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.05</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.02</iyy> <iyz>0</iyz>
          <izz>0.06</izz>
        </inertia>
      </inertial>

      <collision name="door_collision">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/door.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="door_visual">
        <geometry>
          <mesh>
            <uri>model://washing_machine/meshes/door.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ── Door revolute joint ───────────────────────────────────────────── -->
    <joint name="door_hinge" type="revolute">
      <parent>body</parent>
      <child>door</child>
      <!-- Joint frame coincides with door link origin → pose = 0 relative to child -->
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <!-- Rotate around Z (vertical) — door swings sideways (open away from robot) -->
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.7453</upper>  <!-- 100 degrees -->
          <effort>20.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>1.5</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <!-- Challenge starts with door already open (staff pre-opens it).
             Set to 0 if you want to practise the door-opening action instead. -->
        <initial_position>1.7453</initial_position>
      </axis>
    </joint>

    <!-- Prevent the whole model from sliding on the floor -->
    <static>false</static>
    <self_collide>false</self_collide>

  </model>
</sdf>
