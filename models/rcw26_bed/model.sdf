<?xml version="1.0" ?>
<!-- Bed (GLB) — real-furniture GLB variant. GLB unit-normalized + Y-up;
     uniform scale=2.1349 -> real size, roll=1.5708 corrects Y-up->Z-up.
     World footprint ~2.135x1.078 m, height 0.50 m. Box collision approximates mesh. -->
<sdf version="1.10">
  <model name="rcw26_bed">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>30</mass>
        <inertia><ixx>3.10250</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>10.55225</iyy><iyz>0</iyz><izz>12.55025</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.2500 0 0 0</pose>
        <geometry><box><size>2.135 1.078 0.500</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.2500 1.5708 0 0</pose>
        <geometry><mesh><uri>model://rcw26_bed/meshes/bed.glb</uri><scale>2.1349 2.1349 2.1349</scale></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
